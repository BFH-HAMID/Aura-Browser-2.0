# =============================================================================
#  Aura Browser 2.0 — Environment configuration
#  Copy this file to `.env` and adjust the values for your machine.
#  NEVER commit your real `.env` (it may contain API keys).
# =============================================================================

# ---- HTTP server ------------------------------------------------------------
PORT=3000
# Bind address. 0.0.0.0 exposes the app on your LAN; 127.0.0.1 is local-only.
HOST=0.0.0.0
# Set NODE_ENV=production to disable verbose error surfaces.
NODE_ENV=development

# ---- SearXNG aggregator -----------------------------------------------------
# Local Docker instance (see docker-compose.yml) or any public instance.
SEARXNG_URL=http://localhost:8080
SEARXNG_TIMEOUT_MS=15000
# Optional: force a specific set of SearXNG engines (comma separated).
# SEARXNG_ENGINES=

# ---- Optional fallback engines ---------------------------------------------
# If SearXNG is unreachable, Aura can fall back to parsing DuckDuckGo's
# lightweight HTML endpoint (no key required, best-effort).
# Values: ddg-html | none
FALLBACK_ENGINE=ddg-html
# Set to "true" to also try public SearXNG instances (searx.be, etc.) before
# the DDG fallback. Public instances may rate-limit or block datacenter IPs.
SEARXNG_PUBLIC_FALLBACK=false

# ---- Free LLM integration (AI summary + RAG chat) ---------------------------
# Provider priority: groq -> huggingface -> extractive (built-in, zero keys).
# Get a free Groq key at https://console.groq.com  (llama-3.x models are free)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free Hugging Face token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_TIMEOUT_MS=20000

# ---- Weather widget (Open-Meteo, free, no key) ------------------------------
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# ---- Trending / news feed (Google News RSS, free, no key) --------------------
NEWS_RSS_URL=https://news.google.com/rss

# ---- Favicon proxy -----------------------------------------------------------
# provider: duckduckgo | google | none
FAVICON_PROVIDER=duckduckgo

# ---- Reverse image search ----------------------------------------------------
# Uploads are proxied to Google's public search-by-image endpoint (no key).
# REVERSE_IMAGE_SEARXNG_URL=  # optional: SearXNG instance for image_url: searches

# ---- Outbound proxy (used by ALL backend requests) --------------------------
# protocol: http | https | socks4 | socks5  (also configurable at runtime via
# the in-app Proxy Settings panel — that panel only stores config in memory).
# PROXY_PROTOCOL=
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ---- Privacy / security ------------------------------------------------------
# Ephemeral in-memory rate limiting (never touches disk).
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=120
# Block backend fetches to private/loopback/link-local IPs (SSRF protection).
BLOCK_PRIVATE_URLS=true
# Rotating browser-like User-Agent for outbound requests.
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 AuraBrowser/2.0
