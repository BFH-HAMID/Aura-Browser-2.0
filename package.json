{
  "name": "aura-browser-2.0",
  "version": "2.0.0",
  "description": "Aura Browser 2.0 — a 100% free, zero-tracking hybrid meta-search engine & privacy browser web app powered by SearXNG + DuckDuckGo Instant Answers.",
  "type": "commonjs",
  "main": "server/index.js",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --minify",
    "build:css:watch": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --watch",
    "vendor:qrcode": "node scripts/vendor-qrcode.js",
    "postinstall": "node scripts/vendor-qrcode.js",
    "test": "node --test \"server/tests/*.test.js\""
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "multer": "^1.4.5-lts.1",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "qrcode-generator": "^1.4.4",
    "tailwindcss": "^3.4.17"
  }
}
